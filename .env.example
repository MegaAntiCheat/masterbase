DEVELOPMENT=false

STEAM_API_KEY=foo

# Credentials
POSTGRES_USER=MEGASCATTERBOMB
POSTGRES_PASSWORD=masterbase
POSTGRES_HOST=localhost

MINIO_HOST=localhost
MINIO_ACCESS_KEY=MEGASCATTERBOMB
MINIO_SECRET_KEY=masterbase
MINIO_TIMEOUT=5

# Host port mappings (these are exposed on the host machine)
API_PORT=8000
POSTGRES_PORT=8050
MINIO_PORT=9000

# Options
ANALYSIS_BINARY=./path/to/analysis-binary
ANALYSIS_TIMEOUT=3600
TASK_WORKER_THREADS=4
TASK_AGE_RATE_SECONDS=60
CLEANUP_INTERVAL_SECONDS=900

# Container names (not auto-prefixed; set manually for consistency)
API_CONTAINER_NAME=masterbase_api
MINIO_CONTAINER_NAME=masterbase_minio
DB_CONTAINER_NAME=masterbase_db

# Volumes and network use fixed names in compose file, but docker will
# auto-prepend COMPOSE_PROJECT_NAME to their names for isolation.
COMPOSE_PROJECT_NAME=masterbase